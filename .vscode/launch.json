{
   
    "version": "0.2.0",
    "configurations": [
        {
            "name": "MPI - make and debug active file attaching GDB to process",
            "type": "cppdbg",
            "request": "attach",
            "processId": "${command:pickProcess}",
            "program": "${fileDirname}/${fileBasenameNoExtension}",
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "C/C++: make build active file",
            "miDebuggerPath": "/home/bitteal/gdb-13.1/gdb/gdb"
        },
        {
            "name": "C/C++: make and debug active file single process",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/${fileBasenameNoExtension}",
            "args": [
                "-d", "2", "/home/bitteal/PlasmaArc_simulations/new_test_2.inp",
            ],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [
                {
                    "name": "LD_LIBRARY_PATH",
                    "value": "/home/bitteal/libmesh_inst/lib:$LD_LIBRARY_PATH"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/home/bitteal/gdb-13.1/gdb/gdb",
            "preLaunchTask": "Build plasma_arc",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
            ]
        }
    ]
} 