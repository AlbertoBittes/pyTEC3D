{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build plasma_arc",
            "type": "shell",
            "command": "make",
            "args": [
                "-C",
                "src"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Clean plasma_arc",
            "type": "shell",
            "command": "make",
            "args": [
                "-C",
                "src",
                "clean"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Run plasma_arc with MPI",
            "type": "shell",
            "command": "/home/bitteal/petsc/arch-linux-c-debug/bin/mpiexec",
            "args": [
                "-np", "4",
                "${workspaceFolder}/bin/plasma_arc",
                "-d", "2", "/home/bitteal/PlasmaArc_simulations/new_test_2.inp",
            ],
            "group": "test",
            "dependsOn": "Build plasma_arc",
            "problemMatcher": [],
            "isBackground": false,
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "options": {
                "env": {
                    "LD_LIBRARY_PATH": "/home/bitteal/libmesh_inst/lib:${env:LD_LIBRARY_PATH}"
                }
            }
        },
        {
            "label": "Run plasma_arc",
            "type": "shell",
            "command": "${workspaceFolder}/bin/plasma_arc",
            "args": [
                "-d", "2", "/home/bitteal/PlasmaArc_simulations/new_test_2.inp",
                // "-o", "$/home/bitteal/PlasmaArc_simulations/ITER_coarse_mesh/ITER_coarse_mesh_read.exo",
            ],
            "group": "test",
            "dependsOn": "Build plasma_arc",
            "problemMatcher": [],
            "isBackground": false,
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "options": {
                "env": {
                    "LD_LIBRARY_PATH": "/home/bitteal/libmesh_inst/lib:${env:LD_LIBRARY_PATH}"
                }
            }
        }
    ]
}