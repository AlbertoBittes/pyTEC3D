{
    "element_types": {
        "AVA2D_nodal": {
            "dimension": 2,
            "domains": ["NON_CONDUCTING", "SOFT_MAGNETIC", "HARD_MAGNETIC", "STRANDED_CONDUCTOR", "CIRCUIT_COUPLED_CONDUCTOR",
                        "SOLID_CONDUCTOR", "STRANDED_COIL"],
            "time_order": 1,
            "out_of_plane_length": "thickness",
            "constants": {"mu0": "4 * pi * 1e-7"},
            "parameters": {
                "mat.mur[][]": {},
                "mat.rho[][]": {"domain": ["SOLID_CONDUCTOR", "CIRCUIT_COUPLED_CONDUCTOR"]},
                "mat.M[]": {"default": [0, 0, 0]},
                "me.Js": {"domain": ["STRANDED_CONDUCTOR"]},
                "mn.AMPS": {},
                "mn.CURR": {},
                "rc.thickness": {"default": 1},
                "rc.cross_section": {"domain": ["STRANDED_COIL"]},
                "rc.turns": {"domain": ["STRANDED_COIL"]},
                "rc.radius": {"domain": ["STRANDED_COIL"]},
                "rc.resistance": {"domain": ["STRANDED_COIL"]},
                "rc.symmetry": {"domain": ["STRANDED_COIL"]},
                "rc.T[]": {"domain": ["STRANDED_COIL"]}
            },
            "expressions": {
                "nu[][]": "(mu0 * mur).inverse()",
                "b_r[]": {"value": "mu0 * mur * M", "domain": ["HARD_MAGNETIC", "STRANDED_CONDUCTOR", "CIRCUIT_COUPLED_CONDUCTOR", "SOLID_CONDUCTOR", "STRANDED_COIL"]},
                "nu_br[]": {"value": "nu * b_r", "domain": ["HARD_MAGNETIC", "STRANDED_CONDUCTOR", "CIRCUIT_COUPLED_CONDUCTOR", "SOLID_CONDUCTOR", "STRANDED_COIL"]},
                "sigma[][]": {"value": "rho.inverse()", "domain": ["SOLID_CONDUCTOR", "CIRCUIT_COUPLED_CONDUCTOR"]},
                "turns_density": {"value": "turns / (cross_section * resistance)", "domain": ["STRANDED_COIL"]},
                "coil_volume": {"value": "(axisymmetric ? 2 * pi * radius : 1.0) * cross_section * thickness", "domain": ["STRANDED_COIL"]},
                "kvv": {"value": "1 / (resistance * coil_volume)", "domain": ["STRANDED_COIL"]},
                "coil_av[]": {"value": "-turns_density * T", "domain": ["STRANDED_COIL"]},
                "coil_j[]": {"value": "turns_density * T", "domain": ["STRANDED_COIL"]},
                "coil_va[]": {"value": "-symmetry * turns_density * T", "domain": ["STRANDED_COIL"]},
                "coil_ea[]": {"value": "turns_density * T", "domain": ["STRANDED_COIL"]},
                "coil_vv": {"value": "symmetry * kvv", "domain": ["STRANDED_COIL"]},
                "coil_ee": {"value": "-kvv", "domain": ["STRANDED_COIL"]}
            },
            "dof_fields": {
                "A": {"active_components": ["z"]},
                "V": {"active_components": ["z"], "nodal_loads": "AMPS", "domain": ["CIRCUIT_COUPLED_CONDUCTOR"]},
                "VOLT": {"active_components": ["z"], "nodal_loads": "CURR", "domain": ["STRANDED_COIL"]},
                "EMF": {"active_components": ["z"], "domain": ["STRANDED_COIL"]}
            },
            "dof_kernels": {
                "K": [{"trial": "curl(A)", "coeff": "nu", "test": "curl(A)"},
                      {"trial": "grad(V)", "coeff": "sigma", "test": "A", "domain": ["CIRCUIT_COUPLED_CONDUCTOR"]},
                      {"trial": "grad(V)", "coeff": "sigma", "test": "grad(V)", "domain": ["CIRCUIT_COUPLED_CONDUCTOR"]},
                      {"trial": "VOLT", "coeff": "coil_av", "test": "A", "domain": ["STRANDED_COIL"]},
                      {"trial": "EMF", "coeff": "-coil_av", "test": "A", "domain": ["STRANDED_COIL"]},
                      {"trial": "VOLT", "coeff": "coil_vv", "test": "VOLT", "domain": ["STRANDED_COIL"]},
                      {"trial": "EMF", "coeff": "coil_ee", "test": "EMF", "domain": ["STRANDED_COIL"]},
                      {"trial": "dt(A)", "coeff": "sigma", "test": "A", "domain": ["SOLID_CONDUCTOR", "CIRCUIT_COUPLED_CONDUCTOR"]},
                      {"trial": "dt(A)", "coeff": "sigma", "test": "grad(V)", "domain": ["CIRCUIT_COUPLED_CONDUCTOR"]},
                      {"trial": "dt(A)", "coeff": "coil_va", "test": "VOLT", "domain": ["STRANDED_COIL"]},
                      {"trial": "dt(A)", "coeff": "coil_ea", "test": "EMF", "domain": ["STRANDED_COIL"]}],
                "F": [{"coeff": "Js", "test": "A", "domain": ["STRANDED_CONDUCTOR"]},
                      {"coeff": "nu_br", "test": "curl(A)", "domain": ["HARD_MAGNETIC", "STRANDED_CONDUCTOR", "CIRCUIT_COUPLED_CONDUCTOR", "SOLID_CONDUCTOR", "STRANDED_COIL"]}]
            },
            "nodal_fields": {
                "B": {},
                "H": {}
            },
            "nodal_kernels": {
                "B": [{"trial": "curl(A)"}],
                "H": [{"trial": "curl(A)", "coeff": "nu"}, {"coeff": "-nu_br", "domain": ["HARD_MAGNETIC", "STRANDED_CONDUCTOR", "CIRCUIT_COUPLED_CONDUCTOR", "SOLID_CONDUCTOR", "STRANDED_COIL"]}]
            },
            "element_fields": {
                "E": {"active_components": ["z"], "domain": ["SOLID_CONDUCTOR", "CIRCUIT_COUPLED_CONDUCTOR"]},
                "B": {},
                "H": {},
                "Jt": {"active_components": ["z"]}
            },
            "element_kernels": {
                "E": [{"trial": "dt(A)", "coeff": "-", "domain": ["SOLID_CONDUCTOR", "CIRCUIT_COUPLED_CONDUCTOR"]},
                      {"trial": "grad(V)", "coeff": "-", "domain": ["CIRCUIT_COUPLED_CONDUCTOR"]}],
                "B": [{"trial": "curl(A)"}],
                "H": [{"trial": "curl(A)", "coeff": "nu"}, {"coeff": "-nu_br", "domain": ["HARD_MAGNETIC", "STRANDED_CONDUCTOR", "CIRCUIT_COUPLED_CONDUCTOR", "SOLID_CONDUCTOR", "STRANDED_COIL"]}],
                "Jt": [{"coeff": "Js", "domain": ["STRANDED_CONDUCTOR"]},
                       {"trial": "dt(A)", "coeff": "-sigma", "domain": ["SOLID_CONDUCTOR", "CIRCUIT_COUPLED_CONDUCTOR"]},
                       {"trial": "grad(V)", "coeff": "-sigma", "domain": ["CIRCUIT_COUPLED_CONDUCTOR"]},
                       {"trial": "VOLT", "coeff": "coil_j", "domain": ["STRANDED_COIL"]},
                       {"trial": "EMF", "coeff": "-coil_j", "domain": ["STRANDED_COIL"]}]
            }
        },
