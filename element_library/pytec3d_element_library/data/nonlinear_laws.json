{
    "nonlinear_laws": {
        "bh_curve": {
            "source": "mat",
            "input": "B",
            "curve": {"x": "B", "y": "H"},
            "expressions": {"b": "B.norm()", "nu_s": "b > 1e-14 ? curve.value(b) / b : curve.slope(0.0)"},
            "coefficients": {
                "nu[][]": {"secant": "nu_s * I",
                           "tangent": "nu_s * I + (b > 1e-14 ? (curve.slope(b) - nu_s) / (b * b) : 0.0) * outer_product(B, B)"},
                "nu_gauge": {"secant": "nu_s"}
            }
        }
    }
}
