# Compiler settings - change this to your MinGW C++ compiler
CXX=x86_64-w64-mingw32-g++

# MPI directory
MPI_DIR=/usr/lib/x86_64-linux-gnu/openmpi

# Boost directory (assuming default installation path)
BOOST_DIR=/usr/include


# MinGW include directory
MINGW_INCLUDE_DIR=/usr/lib/gcc/x86_64-w64-mingw32/13-win32

# Include path for libMesh, MPI, Boost, and MinGW
INCLUDES=-I/$(LIBMESH_DIR)/include -I/$(PETSC_DIR)/include -I/usr/include/vtk-9.1 -I$(MPI_DIR)/include -I$(BOOST_DIR) -I$(MINGW_INCLUDE_DIR)

# Compiler flags
CXXFLAGS=-std=c++17 -Wall $(INCLUDES) -pthread -O3 -fopenmp

# Linker flags, add your project-specific libraries including MPI
LDFLAGS=-L/$(LIBMESH_DIR)/lib -L/usr/lib/x86_64-linux-gnu -L$(MPI_DIR)/lib -lmesh_opt -lmpi -lmpi_cxx -pthread -fopenmp \
-lvtkCommonCore-9.1 -lvtkCommonDataModel-9.1 \
-lvtkFiltersCore-9.1 -lvtkIOXML-9.1 -lvtkCommonExecutionModel-9.1

# The target executable name
BIN_DIR=../bin
TARGET=$(BIN_DIR)/plasma_arc.exe

# Source files
SOURCES=$(wildcard *.cpp)

# Object files
OBJECTS=$(SOURCES:.cpp=.o)

# Rule to make the object files
%.o: %.cpp
	$(CXX) $(CXXFLAGS) -c $< -o $@

# Rule to make the target executable
$(TARGET): $(OBJECTS)
	$(CXX) $(OBJECTS) -o $(TARGET) $(LDFLAGS)

# Clean rule
clean:
	rm -f $(OBJECTS) $(TARGET)