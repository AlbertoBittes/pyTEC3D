*DIM,coil_elems,array,n_coil_elems
*VGET,coil_elems,ELEM,,elist
alls


*do,i,1,9
   *if,i,eq,1,then
        time,i*0.0001
        TIMINT,OFF
        autots,off
        nsub,1
    *elseif,i,eq,6,then
        time,1e-3
        timint,on
        kbc,1
        tintp,1
        autots,off
        nsub,3
    *elseif,i,eq,7,then
