        timint,on
        autots,off
        nsub,1 
    *endif
    alls
    ! bfedele,all
    
    *do,j,1,n_coil_elems
        csys,0
        el_num = coil_elems(j)
        esel,s,elem,,el_num
        *get,x_coord,elem,el_num,cent,x
        *get,z_coord,elem,el_num,cent,z
        module_square_x=x_coord*x_coord
        module_square_z=z_coord*z_coord
        module_square=module_square_x+module_square_z
        module=SQRT(module_square)
        cos_theta=z_coord/module
        sin_theta=x_coord/module
        fact=i**6
        bfe,all,js,1,cos_theta*fact,0,-sin_theta*fact
        alls
    *enddo
