/clear
*SET,file_name,'two_wires_3D_edge_el_2order'
/filname,%file_name%
/prep7

size = 0.5
csize = size/10
eps=1e-4
et,21,solid236,0,2 ! no volt
et,23,solid236,0,2
et,24,solid236,1,2

! air/non conducting
mp,murx,21,1.1
mp,mury,21,1.2
mp,murz,21,1.3

! conducting bar 
mp,murx,23,1 

mp,murx,24,1
mp,rsvx,24,1e-9 ! High resistance
mp,rsvy,24,2e-9 ! High resistance
mp,rsvz,24,3e-9 ! High resistance

BLOCK,-size,size,-size,size,-size,size
BLOCK,-csize,csize,-size,size,-size,size
BLOCK,-size,size,-csize,csize,-size,size
VSEL,ALL
VOVLAP,ALL
! BLOCK,-csize,csize,-csize,csize,-size,size,
! BLOCK,-size,size,-size,-csize,-size,size,
! BLOCK,-size,size,csize,size,-size,size,
! BLOCK,-size,-csize,-csize,csize,-size,size,
! BLOCK,csize,size,-csize,csize,-size,size,


mshape,0
MSHKEY,1
ESIZE,0.1
TYPE,21
MAT,21
! VSEL,S,VOLU,,12
VMESH,ALL

esel,s,cent,x,-0.185
esel,r,cent,y,0
emodif,all,mat,23
emodif,all,type,23

esel,s,cent,x,+0.185
esel,r,cent,y,0
emodif,all,mat,24
emodif,all,type,24
! alls
! TYPE,21
! MAT,21
! VSEL,u,VOLU,,12
! VMESH,ALL

nummrg,node,1e-5

alls
NSEL,EXT
ESEL,S,MAT,,24
NSLE,R
NSEL,R,LOC,Z,0,5E6
CM,UPPER_FACE_ROD,NODE
CMSEL,S,UPPER_FACE_ROD

alls
NSEL,EXT
ESEL,S,MAT,,24
NSLE,R
NSEL,R,LOC,Z,-5E6,0
CM,LOWER_FACE_ROD,NODE
CMSEL,S,LOWER_FACE_ROD
! CP,1,CURR,all

ALLS

! NSEL,S,LOC,X,-csize-eps,csize+eps
! NSEL,R,LOC,Y,-csize-eps,csize+eps
! NSEL,R,LOC,Z,-size
! 
! CM,LOWER_FACE_ROD,NODE
! CMSEL,S,LOWER_FACE_ROD
! CP,2,VOLT,all

ALLS
CMSEL,S,UPPER_FACE_ROD
*get,NODE_MASTER_UP,NODE,,NUM,MIN

ALLS
CMSEL,S,LOWER_FACE_ROD
*get,NODE_MASTER_LOW,NODE,,NUM,MIN
ALLS

NSEL,S,loc,z,size
CM,Z_BOUND_1,node
NSEL,S,loc,z,-size
CM,Z_BOUND_2,node
cmsel,s,Z_BOUND_1
CMSEL,a,Z_BOUND_2
d,all,az,0
!d,all,ay,0

alls
NSEL,S,loc,y,size
CM,Y_BOUND_1,node
NSEL,S,loc,y,-size
CM,Y_BOUND_2,node
cmsel,s,Y_BOUND_1
CMSEL,a,Y_BOUND_2
d,all,az,0
!d,all,ax,0

alls
NSEL,S,loc,x,size
CM,X_BOUND_1,node
NSEL,S,loc,x,-size
CM,X_BOUND_2,node
cmsel,s,X_BOUND_1
CMSEL,a,X_BOUND_2
d,all,az,0
!d,all,ay,0

ALLS
CMSEL,s,LOWER_FACE_ROD
! NSEL,S,NODE,,NODE_MASTER_LOW
D,ALL,VOLT,0

alls
CMSEL,s,UPPER_FACE_ROD
! NSEL,S,NODE,,NODE_MASTER_UP
D,ALL,VOLT,0
alls
SAVE

/solu
antype,trans ! new analysis
outres,all,ALL
pivcheck,on,every

timint,off
tintp,,,,0.75
kbc,0
alls
!CMSEL,s,UPPER_FACE_ROD
! NSEL,S,NODE,,NODE_MASTER_UP
!F,ALL,AMPS,1
esel,s,mat,,23
bfe,all,js,1,,,1
! FIRST TIME STEP
TIME,0.001
autots,ff
nsub,1
alls
solve

timint,on
tintp,,,,0.75
kbc,0
alls
!CMSEL,s,UPPER_FACE_ROD
! NSEL,S,NODE,,NODE_MASTER_UP
!F,ALL,AMPS,1
esel,s,mat,,23
bfe,all,js,1,,,100
! FIRST TIME STEP
TIME,0.002
autots,off
nsub,5
alls
solve

timint,on
tintp,,,,0.65
kbc,0
alls
!CMSEL,s,UPPER_FACE_ROD
! NSEL,S,NODE,,NODE_MASTER_UP
!F,ALL,AMPS,1
esel,s,mat,,23
bfe,all,js,1,,,0
! FIRST TIME STEP
TIME,0.003
autots,off
nsub,5
alls
solve
! /output,'%file_name%_1',bfelist
! bfelist
! /out
! /output,'%file_name%_1',flist
! flist
! /out
! /output,'%file_name%_1',dlist
! dlist
! /out
! /output,'%file_name%_1',rlist
! rlist
! /out
! /output,'%file_name%_1',mplist
! mplist
! /out
! /output,'%file_name%_1',etlist
! etlist
! /out
! /output,'%file_name%_1',cplist
! cplist
! /out

!ematwrite,yes

! *SMAT,MatKD,D,IMPORT,EMAT,%file_name%.emat,STIFF,10
! *PRINT,MatKD,./matrix/Kdense_elem_%i%_2.matrix
! *SMAT,MatCD,D,IMPORT,EMAT,%file_name%.emat,DAMP,10
! *PRINT,MatCD,./matrix/Cdense_elem_%i%_2.matrix
!*SMAT,MaCD,D,IMPORT,EMAT,single_element_cond.emat,MASS,1
!*PRINT,MatCD,./matrix/Cdense_elem.matrix
! *VEC,VecRHS,D,IMPORT,EMAT,%file_name%.emat,RHS,10
! *PRINT,VecRHS,./matrix/RHS_elem_%i%_2.matrix

CDWRITE,ALL,'%file_name%','cdb',,'%file_name%','iges' 

! SECOND TIME STEP
! TIME,1
! timint,oFF
! autots,on
! nsub,6,20,4

! alls
! solve

! FINISH